# ─── Arc Blockchain ───────────────────────────────────
ARC_TESTNET_RPC_URL=https://arc-testnet.drpc.org
USDC_ADDRESS=0x3600000000000000000000000000000000000000
CONTRACT_ADDRESS=

# ─── Deployer Private Key (for contract deployment only — never commit!) ──
PRIVATE_KEY=

# ─── Authentication ───────────────────────────────────
# Required: Generate a random secret, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ─── GitHub API Token (optional — prevents rate limits) ───
GITHUB_TOKEN=

# ─── Database ─────────────────────────────────────────
# Local SQLite (default for development)
DATABASE_URL=sqlite:///../database/taskbit.db

# Production (e.g. MySQL — only if deploying to a server)
# DATABASE_URL=mysql://user:pass@host:3306/taskbit